# ─────────────────────────────────────────────────────────────────────────────
# Maestro SDK — Environment Configuration
#
# Copy this file to .env and fill in your values.
# Variables already set in the environment always take priority over this file.
#
#   cp .env.example .env
#   # edit .env, then:
#   import maestro
#   maestro.load_env()          # loads .env from current directory
#   maestro.load_env(".env.prod") # or specify a path
# ─────────────────────────────────────────────────────────────────────────────


# ── API Keys ──────────────────────────────────────────────────────────────────
# Anthropic — get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI — get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here


# ── Default LLM Models ────────────────────────────────────────────────────────
# These are used by make_anthropic() and make_openai() when no model= is passed.

# Anthropic model (claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5-20251001)
MAESTRO_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Max tokens for Anthropic responses (Anthropic requires this to be set explicitly)
MAESTRO_ANTHROPIC_MAX_TOKENS=4096

# Anthropic sampling temperature (0.0 – 1.0)
MAESTRO_ANTHROPIC_TEMPERATURE=1.0

# OpenAI model (gpt-4o | gpt-4o-mini | o1 | o1-mini | o3-mini)
MAESTRO_OPENAI_MODEL=gpt-4o-mini

# OpenAI base URL — override for Azure, Ollama, Together AI, Groq, etc.
# Leave blank to use the default OpenAI endpoint.
# MAESTRO_OPENAI_BASE_URL=http://localhost:11434/v1

# OpenAI sampling temperature
MAESTRO_OPENAI_TEMPERATURE=1.0


# ── Retry ─────────────────────────────────────────────────────────────────────
# Used by make_anthropic().with_retry() and make_openai().with_retry()
# when no explicit RetryPolicy is passed.

# Maximum number of attempts (1 = no retry)
MAESTRO_RETRY_MAX_ATTEMPTS=3

# Maximum delay between retries in seconds (exponential backoff is capped here)
MAESTRO_RETRY_MAX_DELAY=60.0

# Base delay for the first retry in seconds
MAESTRO_RETRY_BASE_DELAY=1.0


# ── Logging ───────────────────────────────────────────────────────────────────
# Controls the root Maestro logger level.
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
MAESTRO_LOG_LEVEL=INFO


# ── Batch ─────────────────────────────────────────────────────────────────────
# Default settings for JobBuilder when none are specified.

# Records per write batch (higher = less I/O, more memory)
MAESTRO_BATCH_SIZE=100

# Records allowed to fail before job is aborted (-1 = unlimited)
MAESTRO_ERROR_THRESHOLD=-1


# ── Scheduler ─────────────────────────────────────────────────────────────────
# Defaults for the Scheduler class.

# How often the scheduler checks for due tasks (seconds)
MAESTRO_SCHEDULER_TICK=1.0

# Maximum concurrent tasks in the thread pool
MAESTRO_SCHEDULER_MAX_WORKERS=4


# ── Observability ─────────────────────────────────────────────────────────────
# Controls automatic metric collection.

# Enable/disable the global in-memory observer (true | false)
MAESTRO_METRICS_ENABLED=true

# Prometheus metrics export file path (leave blank to disable)
# MAESTRO_PROMETHEUS_PATH=/tmp/maestro_metrics.prom
